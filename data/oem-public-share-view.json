{
  "version": "1.0",
  "status": "foundation",
  "description": "Public sharing configuration for Toyota and Lexus OEM catalog records.",
  "enabled": true,

  "sharing": {
    "enabled": true,
    "copyLink": true,
    "nativeShare": true,
    "whatsapp": true,
    "facebook": true,
    "telegram": true,
    "email": true
  },

  "sharedContent": {
    "includePartName": true,
    "includeOemNumber": true,
    "includeBrand": true,
    "includeModel": true,
    "includePrimaryImage": true,
    "includePublicUrl": true
  },

  "url": {
    "useCanonicalUrl": true,
    "excludeInternalParameters": true,
    "preserveLanguage": true,
    "preservePublicRecordReference": true
  },

  "socialPreview": {
    "enabled": true,
    "useOpenGraphData": true,
    "useTwitterCardData": true,
    "usePrimaryImage": true
  },

  "visibility": {
    "publishedRecordsOnly": true,
    "publicRecordsOnly": true,
    "hideArchived": true,
    "hideDisabled": true
  },

  "language": {
    "supported": [
      "en",
      "ar"
    ],
    "default": "en",
    "supportRtl": true
  },

  "safety": {
    "neverShareInternalRecordIds": true,
    "neverSharePrivateInventoryData": true,
    "neverShareSupplierInformation": true,
    "neverShareInternalPricingNotes": true,
    "neverShareCustomerInformation": true
  }
}
