{
  "version": "1.0",
  "status": "foundation",
  "description": "Public availability display configuration for Toyota and Lexus OEM catalog records.",
  "enabled": true,

  "statusDisplay": {
    "enabled": true,
    "showInStock": true,
    "showLowStock": true,
    "showOutOfStock": true,
    "showOnOrder": true,
    "showUnknown": true
  },

  "messages": {
    "inStock": "Available",
    "lowStock": "Limited availability",
    "outOfStock": "Currently unavailable",
    "onOrder": "Available on order",
    "unknown": "Availability on request"
  },

  "quantity": {
    "showExactQuantity": false,
    "showQuantityRange": false,
    "showMinimumQuantity": false
  },

  "location": {
    "showWarehouse": false,
    "showBranch": false,
    "showExactLocation": false,
    "showCity": false
  },

  "actions": {
    "allowInquiry": true,
    "allowWhatsApp": true,
    "allowPhone": true,
    "allowStockRequest": true
  },

  "inquiry": {
    "includeOemNumber": true,
    "includePartName": true,
    "includeRequestedQuantity": true,
    "includeVehicleInformation": true,
    "includeVin": true
  },

  "visibility": {
    "publishedRecordsOnly": true,
    "publicRecordsOnly": true,
    "hideArchived": true,
    "hideDisabled": true
  },

  "language": {
    "supported": [
      "en",
      "ar"
    ],
    "default": "en",
    "supportRtl": true
  },

  "safety": {
    "neverExposeExactInventoryQuantity": true,
    "neverExposeExactInventoryLocation": true,
    "neverExposeSupplierInformation": true,
    "neverExposeInternalStockNotes": true,
    "neverExposePrivateInventoryData": true
  }
}
