{
  "version": "1.0",
  "status": "foundation",
  "description": "Public image gallery configuration for Toyota and Lexus OEM catalog records.",
  "enabled": true,

  "gallery": {
    "enabled": true,
    "showPrimaryImage": true,
    "showAdditionalImages": true,
    "allowThumbnailNavigation": true,
    "allowImageZoom": true,
    "allowFullscreen": true,
    "allowImageSharing": true
  },

  "imageTypes": {
    "primary": true,
    "product": true,
    "packaging": true,
    "label": true,
    "technical": true,
    "vehicleFitment": true
  },

  "display": {
    "maximumImages": 12,
    "showImageCounter": true,
    "showLoadingState": true,
    "showMissingImageState": true
  },

  "imageInformation": {
    "showCaption": true,
    "showAltText": false,
    "showImageType": false
  },

  "imageRules": {
    "requirePublicImage": true,
    "allowExternalImageUrl": true,
    "allowStoredImagePath": true,
    "preferPrimaryImage": true,
    "hideBrokenImages": true
  },

  "navigation": {
    "openImageViewer": true,
    "allowPreviousNext": true,
    "preserveRecordContext": true
  },

  "language": {
    "supported": [
      "en",
      "ar"
    ],
    "default": "en",
    "supportRtl": true
  },

  "visibility": {
    "publishedRecordsOnly": true,
    "publicRecordsOnly": true,
    "hideArchived": true,
    "hideDisabled": true,
    "hidePrivateImages": true
  },

  "safety": {
    "neverExposeInternalImagePaths": true,
    "neverExposePrivateSupplierImages": true,
    "neverExposeAdminOnlyImages": true,
    "neverExposePrivateMetadata": true
  }
}
