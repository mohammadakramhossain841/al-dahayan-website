{
  "version": "1.0",
  "status": "foundation",
  "description": "Public vehicle fitment display configuration for Toyota and Lexus OEM catalog records.",
  "enabled": true,

  "fitment": {
    "enabled": true,
    "showBrand": true,
    "showModel": true,
    "showGeneration": true,
    "showModelYears": true,
    "showEngineCode": true,
    "showEngineType": true,
    "showBodyType": true,
    "showTransmission": true,
    "showDriveType": true,
    "showTrim": true,
    "showMarketSpec": true,
    "showRegion": true,
    "showChassisCode": true
  },

  "matching": {
    "requireVerifiedFitment": true,
    "allowMultipleVehicles": true,
    "showExactMatchesFirst": true,
    "showRelatedMatches": true,
    "showUnverifiedMatches": false,
    "neverAssumeFitment": true
  },

  "display": {
    "groupByBrand": true,
    "groupByModel": true,
    "groupByYear": true,
    "groupByEngine": true,
    "allowExpandCollapse": true,
    "showFitmentCount": true,
    "showFitmentSummary": true
  },

  "actions": {
    "openVehicleDetails": true,
    "openCompatibleParts": true,
    "startInquiry": true,
    "searchByVehicle": true
  },

  "inquiry": {
    "includeBrand": true,
    "includeModel": true,
    "includeModelYear": true,
    "includeEngineCode": true,
    "includeBodyType": true,
    "includeTransmission": true,
    "includeDriveType": true,
    "includeVin": true
  },

  "visibility": {
    "publishedRecordsOnly": true,
    "publicRecordsOnly": true,
    "hideArchived": true,
    "hideDisabled": true
  },

  "language": {
    "supported": [
      "en",
      "ar"
    ],
    "default": "en",
    "supportRtl": true
  },

  "safety": {
    "neverExposeInternalFitmentNotes": true,
    "neverExposeSupplierInformation": true,
    "neverExposePrivateVehicleData": true,
    "neverShowUnverifiedFitmentAsVerified": true
  }
}
